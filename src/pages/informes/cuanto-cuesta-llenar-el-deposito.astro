---
// Informe: cuánto cuesta hoy llenar el depósito según el tamaño, el carburante y dónde repostes.
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import { cheapest, getProvinces, getStations, getUpdatedAt, isPeninsular, nationalStats, provincePath, stationPath, statsFor } from '../../lib/data';
import type { FuelKey } from '../../lib/types';
import { date } from '../../components/util/format';
import { fuelName, priceU } from '../../components/util/texts';
import { placeOf } from '../../components/util/places';

const national = nationalStats();
const fuels: FuelKey[] = (['gasolina95', 'diesel', 'gasolina98', 'glp'] as FuelKey[]).filter((f) => national[f]);
const SIZES = [40, 50, 60, 70];
const updatedAt = getUpdatedAt();
const eur = (n: number) => `${n.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} €`;

const pen = getStations().filter((s) => isPeninsular(s.provinceId));
const penStats = statsFor(pen);
const provs = getProvinces()
  .filter((p) => isPeninsular(p.id))
  .map((p) => ({ p, stats: statsFor(pen.filter((s) => s.provinceId === p.id)) }));
function extremes(f: FuelKey) {
  const l = provs.filter((x) => x.stats[f] && x.stats[f]!.count >= 5).sort((a, b) => a.stats[f]!.avg - b.stats[f]!.avg);
  return { low: l[0], high: l[l.length - 1] };
}
const e95 = extremes('gasolina95');
const eD = extremes('diesel');
const best95 = cheapest(pen, 'gasolina95', 1)[0];

// Cifras de referencia fijas (mediana de península y Baleares del 23-11-2026) para los ejemplos resueltos.
const REF_DATE = '23-11-2026';
const REF95 = 1.569;
const REFD = 1.808;
const nf1 = new Intl.NumberFormat('es-ES', { maximumFractionDigits: 1 });
const p3 = (n: number) => n.toLocaleString('es-ES', { minimumFractionDigits: 3, maximumFractionDigits: 3 });

// Depósitos y consumos reales orientativos por tipo de vehículo. Rangos aproximados: cada modelo es distinto.
const VEHICULOS: Array<{ tipo: string; fuel: 'g' | 'd'; tank: number; tankTxt: string; cons: number }> = [
  { tipo: 'Utilitario de gasolina', fuel: 'g', tank: 42, tankTxt: '35–45 l', cons: 6 },
  { tipo: 'Compacto de gasolina', fuel: 'g', tank: 50, tankTxt: '45–55 l', cons: 6.8 },
  { tipo: 'Compacto diésel', fuel: 'd', tank: 50, tankTxt: '45–55 l', cons: 5.2 },
  { tipo: 'Híbrido no enchufable', fuel: 'g', tank: 43, tankTxt: '35–50 l', cons: 4.8 },
  { tipo: 'SUV mediano de gasolina', fuel: 'g', tank: 55, tankTxt: '50–60 l', cons: 8 },
  { tipo: 'SUV grande o todoterreno diésel', fuel: 'd', tank: 70, tankTxt: '60–80 l', cons: 7.5 },
  { tipo: 'Furgoneta diésel', fuel: 'd', tank: 75, tankTxt: '60–90 l', cons: 8.5 },
];

const FAQ: Array<{ q: string; a: string }> = [
  {
    q: '¿Por qué no me caben los litros que dice el catálogo?',
    a: 'Porque casi nunca llegas con el depósito vacío. Cuando se enciende la luz de reserva suelen quedar entre 5 y 10 litros, así que en un depósito de 50 litros normalmente echas 40–45. Además, la capacidad nominal es aproximada.',
  },
  {
    q: '¿Es mejor llenar el depósito o echar 20 €?',
    a: 'El litro cuesta lo mismo eches lo que eches. Llenar tiene la ventaja de que repostas menos veces y puedes elegir la gasolinera barata; echar poco te obliga a parar más a menudo y aumenta la probabilidad de repostar donde te pille.',
  },
  {
    q: '¿Qué precio usa esta página?',
    a: 'El precio medio de cada carburante calculado con los precios que publica el Ministerio para todas las gasolineras de España, actualizado cada hora. Los ejemplos resueltos usan cifras de referencia fijas para que se puedan comprobar.',
  },
  {
    q: '¿Por qué es más barato llenar en Canarias, Ceuta y Melilla?',
    a: 'Porque allí no se aplican el IVA ni el impuesto especial sobre hidrocarburos de la península, sino impuestos propios más bajos. Por eso las comparaciones de esta página se hacen con la península.',
  },
  {
    q: '¿Qué pasa si pido «lleno» en una gasolinera automática?',
    a: 'El terminal reserva una cantidad en tu tarjeta (por ejemplo, 100 o 150 €) y al terminar solo te cobra lo que has echado. La reserva puede tardar unos días en liberarse, según el banco.',
  },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const title = '¿Cuánto cuesta llenar el depósito hoy? Gasolina y diésel';
const description = national.gasolina95
  ? `Llenar un depósito de 50 litros de gasolina 95 cuesta hoy ${eur(national.gasolina95.avg * 50)} de media en España. Precio para 40, 50, 60 y 70 litros, por carburante y provincia.`
  : 'Cuánto cuesta llenar el depósito hoy en España.';
---
<Base
  title={title}
  description={description}
  path="/informes/cuanto-cuesta-llenar-el-deposito/"
  fuels={fuels}
  ogType="article"
  jsonLd={faqLd}
  breadcrumbs={[{ name: 'Informes', path: '/informes/' }, { name: 'Llenar el depósito', path: '/informes/cuanto-cuesta-llenar-el-deposito/' }]}
>
  <article class="article">
    <h1>¿Cuánto cuesta llenar el depósito hoy?</h1>
    <p class="article-meta">Datos del {date(updatedAt)}. Se actualiza cada hora.</p>
    {national.gasolina95 && national.diesel && (
      <p class="lead">
        Llenar un depósito de 50 litros cuesta hoy <strong>{eur(national.gasolina95.avg * 50)}</strong> de gasolina 95 y{' '}
        <strong>{eur(national.diesel.avg * 50)}</strong> de diésel, con el precio medio de España.
      </p>
    )}

    <AdSlot position="top" />

    <h2>Según el tamaño del depósito</h2>
    <p>Con el precio medio nacional de cada carburante. Un utilitario suele tener entre 40 y 45 litros, una berlina o un SUV compacto unos 50–55 y un SUV grande o una furgoneta 60–70.</p>
    <div class="table-scroll">
      <table class="data-table">
        <thead><tr><th>Carburante</th><th class="n">Precio medio</th>{SIZES.map((l) => <th class="n">{l} l</th>)}</tr></thead>
        <tbody>
          {fuels.map((f) => (
            <tr><td>{fuelName(f)}</td><td class="n">{priceU(national[f]!.avg, f)}</td>{SIZES.map((l) => <td class="n">{eur(national[f]!.avg * l)}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>Dónde repostes cambia mucho la cuenta</h2>
    <div class="table-scroll">
      <table class="data-table">
        <thead><tr><th>Depósito de 50 l</th><th class="n">Gasolina 95</th><th class="n">Diésel</th></tr></thead>
        <tbody>
          {penStats.gasolina95 && penStats.diesel && (
            <>
              <tr><td>Gasolinera más barata de la península</td><td class="n good">{eur(penStats.gasolina95.min * 50)}</td><td class="n good">{eur(penStats.diesel.min * 50)}</td></tr>
              <tr><td>Media de la península</td><td class="n">{eur(penStats.gasolina95.avg * 50)}</td><td class="n">{eur(penStats.diesel.avg * 50)}</td></tr>
              <tr><td>Gasolinera más cara de la península</td><td class="n bad">{eur(penStats.gasolina95.max * 50)}</td><td class="n bad">{eur(penStats.diesel.max * 50)}</td></tr>
            </>
          )}
          {e95.low && eD.low && <tr><td>Provincia más barata (media)</td><td class="n">{eur(e95.low.stats.gasolina95!.avg * 50)} · <a href={provincePath(e95.low.p)}>{e95.low.p.name}</a></td><td class="n">{eur(eD.low!.stats.diesel!.avg * 50)} · <a href={provincePath(eD.low!.p)}>{eD.low!.p.name}</a></td></tr>}
          {e95.high && eD.high && <tr><td>Provincia más cara (media)</td><td class="n">{eur(e95.high.stats.gasolina95!.avg * 50)} · <a href={provincePath(e95.high.p)}>{e95.high.p.name}</a></td><td class="n">{eur(eD.high!.stats.diesel!.avg * 50)} · <a href={provincePath(eD.high!.p)}>{eD.high!.p.name}</a></td></tr>}
        </tbody>
      </table>
    </div>
    {penStats.gasolina95 && (
      <p>
        Entre la gasolinera más barata y la media de la península hay {eur((penStats.gasolina95.avg - penStats.gasolina95.min) * 50)} por
        depósito de gasolina 95. No hace falta irse a la más barata de España: casi siempre hay una gasolinera bastante más barata que la media
        a pocos kilómetros. Búscala con <a href="/cerca/">gasolineras cerca de mí</a> o calcula si te compensa el desvío con la{' '}
        <a href="/compensa-desviarse/">calculadora de desvío</a>.
      </p>
    )}
    {best95 && (
      <p class="small muted">
        La gasolina 95 más barata de la península está ahora en <a href={stationPath(best95)}>{best95.brand}</a> de{' '}
        <a href={placeOf(best95).municipalityPath}>{placeOf(best95).municipality}</a> ({priceU(best95.prices.gasolina95!, 'gasolina95')}).
      </p>
    )}

    <h2>Cuánto gastas al mes</h2>
    <p>
      Si haces 1.000 km al mes con un consumo real de 6,5 l/100 km gastas unos 65 litros:
      {national.gasolina95 && <> {eur(national.gasolina95.avg * 65)} al mes en gasolina 95</>}
      {national.diesel && <> o {eur(national.diesel.avg * 65)} en diésel</>}. Haz tu propia cuenta con la{' '}
      <a href="/calculadora-gasolina/">calculadora de gasolina</a>.
    </p>

    <h2>Cómo se calcula</h2>
    <ul>
      <li><strong>Coste de llenar</strong> = litros que echas × precio por litro.</li>
      <li><strong>Litros que echas</strong> = capacidad del depósito − lo que queda dentro. Si llegas en reserva, suelen quedar 5–10 litros.</li>
      <li><strong>Autonomía</strong> = litros ÷ consumo (l/100 km) × 100.</li>
      <li><strong>Diferencia entre dos gasolineras</strong> = litros × diferencia de precio por litro.</li>
    </ul>
    <p>
      Las tablas de arriba usan el precio medio de hoy, que se recalcula cada hora con los datos oficiales. Los ejemplos de abajo usan
      precios de referencia fijos del {REF_DATE} (mediana de península y Baleares): gasolina 95 a {p3(REF95)} €/l y gasóleo A a {p3(REFD)} €/l.
    </p>

    <h2>Tres ejemplos resueltos</h2>
    <h3>1. Un utilitario que llega en reserva</h3>
    <p>
      Depósito de 45 litros y quedan unos 7: echas 38 litros de gasolina 95. Cuestan 38 × {p3(REF95)} = <strong>{eur(38 * REF95)}</strong>.
      Con un consumo real de 6 l/100 km te dan para unos {Math.round((38 / 6) * 100)} km.
    </p>
    <h3>2. Un SUV diésel de 60 litros, de vacío a lleno</h3>
    <p>
      60 × {p3(REFD)} = <strong>{eur(60 * REFD)}</strong>. Si repostas en una gasolinera 12 céntimos más barata que la media, te ahorras{' '}
      {eur(60 * 0.12)} en ese depósito; con un lleno cada dos semanas, unos {eur(60 * 0.12 * 26)} al año.
    </p>
    <h3>3. Gasolina o diésel con el mismo depósito</h3>
    <p>
      Llenar 50 litros cuesta {eur(50 * REF95)} de gasolina 95 y {eur(50 * REFD)} de gasóleo A con los precios del {REF_DATE}: el diésel sale{' '}
      {eur(50 * (REFD - REF95))} más caro por depósito. Pero un diésel suele recorrer más kilómetros con esos litros, así que lo que
      importa es el coste por kilómetro. Lo comparamos en <a href="/guias/gasolina-o-diesel/">¿gasolina o diésel?</a>
    </p>

    <h2>Depósito, autonomía y coste por tipo de vehículo</h2>
    <p>
      Capacidades y consumos <strong>orientativos</strong>: cada modelo es distinto, así que mira la ficha técnica de tu coche. El coste
      del depósito lleno usa un valor típico de cada rango y los precios de referencia del {REF_DATE}.
    </p>
    <div class="table-scroll">
      <table class="data-table">
        <thead><tr><th>Vehículo</th><th>Depósito habitual</th><th class="n">Consumo real orientativo</th><th class="n">Autonomía aprox.</th><th class="n">Lleno (valor típico)</th></tr></thead>
        <tbody>
          {VEHICULOS.map((v) => (
            <tr>
              <td>{v.tipo}</td>
              <td>{v.tankTxt}</td>
              <td class="n">{nf1.format(v.cons)} l/100 km</td>
              <td class="n">{Math.round((v.tank / v.cons) * 10) * 10} km</td>
              <td class="n">{eur(v.tank * (v.fuel === 'g' ? REF95 : REFD))} ({v.tank} l)</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>Preguntas frecuentes</h2>
    {FAQ.map((f) => (
      <>
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </>
    ))}

    <h2>Guías relacionadas</h2>
    <ul>
      <li><a href="/guias/como-ahorrar-gasolina/">Cómo ahorrar gasolina</a>: lo que más se nota en cada depósito.</li>
      <li><a href="/guias/mejor-dia-para-repostar/">¿Cuál es el mejor día para echar gasolina?</a></li>
      <li><a href="/guias/impuestos-de-la-gasolina/">Qué impuestos pagas en cada litro</a>, y por qué en Canarias es más barato.</li>
      <li><a href="/guias/gasolineras-desatendidas/">Gasolineras desatendidas</a>: cómo funciona el «lleno» con preautorización.</li>
      <li><a href="/guias/compensa-desviarse-para-repostar/">¿Compensa desviarse para repostar?</a> y la <a href="/compensa-desviarse/">calculadora de desvío</a>.</li>
    </ul>
  </article>

  <AdSlot position="bottom" />
</Base>
