---
// Gráfico de líneas en SVG hecho a mano para los informes: una o dos series en el mismo eje
// (p. ej. gasolina 95 y diésel), con leyenda, etiqueta al final de cada línea, tooltip nativo
// por punto y tabla de datos accesible. Sin librerías ni JS.
import { price, shortDay } from '../util/format';

interface Point {
  date: string;
  value: number;
}
interface Series {
  label: string;
  points: Point[];
}
interface Props {
  series: Series[];
  /** Título accesible del gráfico. */
  title: string;
  /** Texto que resume el gráfico (va en <desc> y en el pie). */
  caption: string;
  /** Formato de los valores: precio (1,575) o céntimos (23,0 cts). */
  format?: 'price' | 'cents';
  /** Unidad para la tabla: "€/l". */
  unit?: string;
  id: string;
}
const { series, title, caption, format = 'price', unit = '€/l', id } = Astro.props;

const W = 640;
const H = 260;
const PAD = { top: 16, right: 92, bottom: 30, left: 64 };
const innerW = W - PAD.left - PAD.right;
const innerH = H - PAD.top - PAD.bottom;

const fmtC = new Intl.NumberFormat('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const fmt = (v: number) => (format === 'cents' ? `${fmtC.format(v * 100)} cts` : price(v));

const all = series.flatMap((s) => s.points);
const values = all.map((p) => p.value);
const min = Math.min(...values);
const max = Math.max(...values);
const steps = [0.005, 0.01, 0.02, 0.05, 0.1, 0.2];
const step = steps.find((s) => s >= Math.max(max - min, 0.01) / 4) ?? 0.5;
const y0 = Math.floor(min / step) * step;
const y1 = Math.ceil(max / step) * step;
const ticks: number[] = [];
for (let v = y0; v <= y1 + step / 2; v += step) ticks.push(Math.round(v * 1000) / 1000);

const day = (iso: string) => Date.parse(`${iso}T00:00:00Z`) / 86_400_000;
const dates = [...new Set(all.map((p) => p.date))].sort();
const d0 = day(dates[0]!);
const span = Math.max(day(dates[dates.length - 1]!) - d0, 1);
const x = (iso: string) => PAD.left + ((day(iso) - d0) / span) * innerW;
const y = (v: number) => PAD.top + innerH - ((v - y0) / (y1 - y0 || 1)) * innerH;

const n = dates.length;
const labelDates = [...new Set([0, Math.round((n - 1) / 3), Math.round((2 * (n - 1)) / 3), n - 1])].map((i) => dates[i]!);

const lines = series.map((s, k) => {
  const d = s.points.map((p, i) => `${i ? 'L' : 'M'}${x(p.date).toFixed(1)},${y(p.value).toFixed(1)}`).join('');
  const last = s.points[s.points.length - 1]!;
  return { k, label: s.label, d, last, lx: x(last.date), ly: y(last.value) };
});
// Si las etiquetas finales se pisan, se separan un poco.
if (lines.length === 2 && Math.abs(lines[0]!.ly - lines[1]!.ly) < 26) {
  const [a, b] = lines[0]!.ly < lines[1]!.ly ? [lines[0]!, lines[1]!] : [lines[1]!, lines[0]!];
  const mid = (a.ly + b.ly) / 2;
  a.ly = mid - 13;
  b.ly = mid + 13;
}
const endY = (k: number) => lines[k]!.ly;
---
<figure class="lc">
  {series.length > 1 && (
    <ul class="legend" aria-hidden="true">
      {series.map((s, k) => <li><span class={`key s${k}`}></span>{s.label}</li>)}
    </ul>
  )}
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${id}-t ${id}-d`} preserveAspectRatio="xMidYMid meet">
    <title id={`${id}-t`}>{title}</title>
    <desc id={`${id}-d`}>{caption}</desc>
    <g class="grid">
      {ticks.map((t) => (
        <>
          <line x1={PAD.left} x2={W - PAD.right} y1={y(t)} y2={y(t)} />
          <text x={PAD.left - 8} y={y(t)} dominant-baseline="central" text-anchor="end">{format === 'cents' ? fmtC.format(t * 100) : price(t)}</text>
        </>
      ))}
    </g>
    <g class="xaxis">
      {labelDates.map((d, k) => (
        <text x={x(d)} y={H - 6} text-anchor={k === 0 ? 'start' : k === labelDates.length - 1 ? 'end' : 'middle'}>{shortDay(d)}</text>
      ))}
    </g>
    {lines.map((l) => <path class={`line s${l.k}`} d={l.d} />)}
    {lines.map((l) => (
      <>
        <circle class={`end s${l.k}`} cx={l.lx} cy={y(l.last.value)} r="4.5" />
        <text class="endlabel" x={l.lx + 10} y={endY(l.k)} dominant-baseline="central">{fmt(l.last.value)}</text>
      </>
    ))}
    {series.map((s) => s.points.map((p) => (
      <circle class="hit" cx={x(p.date)} cy={y(p.value)} r="8">
        <title>{s.label}, {shortDay(p.date)}: {fmt(p.value)}</title>
      </circle>
    )))}
  </svg>
  <figcaption class="small muted">{caption}</figcaption>
  <details class="chart-data">
    <summary>Ver los datos en una tabla</summary>
    <div class="table-scroll">
      <table>
        <thead>
          <tr><th scope="col">Día</th>{series.map((s) => <th scope="col" class="num">{s.label}{format === 'price' ? ` (${unit})` : ''}</th>)}</tr>
        </thead>
        <tbody>
          {[...dates].reverse().map((d) => (
            <tr>
              <td>{shortDay(d)}</td>
              {series.map((s) => {
                const p = s.points.find((q) => q.date === d);
                return <td class="num">{p ? fmt(p.value) : '—'}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .lc {
    /* paleta categórica validada (contraste y daltonismo) para claro y oscuro */
    --s0: #1f6fd1;
    --s1: #c2570c;
    margin: 1.25rem 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 12px 12px;
    box-shadow: var(--shadow);
  }
  @media (prefers-color-scheme: dark) {
    .lc {
      --s0: #4a8ee8;
      --s1: #d9722f;
    }
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .legend {
    display: flex;
    gap: 16px;
    list-style: none;
    margin: 0 0 6px;
    padding: 0 4px;
    font-size: 0.875rem;
    color: var(--ink);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
  }
  .key {
    width: 16px;
    height: 3px;
    border-radius: 2px;
    display: inline-block;
  }
  .key.s0 {
    background: var(--s0);
  }
  .key.s1 {
    background: var(--s1);
  }
  .grid line {
    stroke: var(--border);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  text {
    fill: var(--muted);
    font-size: 12px;
    font-family: var(--font);
    font-variant-numeric: tabular-nums;
  }
  .endlabel {
    fill: var(--ink);
    font-weight: 600;
  }
  .line {
    fill: none;
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .line.s0 {
    stroke: var(--s0);
  }
  .line.s1 {
    stroke: var(--s1);
  }
  .end {
    stroke: var(--surface);
    stroke-width: 2;
  }
  .end.s0 {
    fill: var(--s0);
  }
  .end.s1 {
    fill: var(--s1);
  }
  .hit {
    fill: transparent;
  }
  .hit:hover {
    fill: var(--ink);
    fill-opacity: 0.18;
  }
  @media (max-width: 600px) {
    text {
      font-size: 22px;
    }
  }
  figcaption {
    margin-top: 8px;
    padding: 0 4px;
  }
  .chart-data {
    padding: 0 4px;
    font-size: 0.875rem;
  }
  .chart-data summary {
    cursor: pointer;
    color: var(--muted);
    padding: 6px 0;
  }
  .chart-data table {
    border-collapse: collapse;
    margin-top: 6px;
  }
  .chart-data th,
  .chart-data td {
    padding: 3px 14px 3px 0;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }
  .chart-data .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
</style>
